{
  "name": "metodos-numericos",
  "version": "1.0.0",
  "description": "Aplicación educativa de escritorio para estudiar métodos numéricos.",
  "author": "Proyecto académico de Métodos Numéricos",
  "main": "electron/principal.cjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "iniciar": "ng serve",
    "build": "ng build",
    "compilar": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "probar": "ng test --watch=false",
    "escritorio": "npm run compilar && electron .",
    "preparar:electron": "node electron/preparar-empaquetado.cjs",
    "ejecutable": "npm run compilar && npm run preparar:electron && electron-builder --projectDir .electron-app --win portable",
    "verificar:ejecutable": "node electron/verificar-ejecutable.cjs"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "jsxgraph": "^1.13.3",
    "katex": "^0.18.7",
    "mathjs": "^15.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@types/katex": "^0.16.8",
    "chrome-remote-interface": "^0.34.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "edu.metodosnumericos.app",
    "productName": "Métodos Numéricos",
    "asar": true,
    "directories": {
      "app": ".electron-app",
      "output": "release"
    },
    "files": [
      "**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "MetodosNumericos.exe"
    },
    "portable": {
      "artifactName": "MetodosNumericos.exe"
    }
  }
}
